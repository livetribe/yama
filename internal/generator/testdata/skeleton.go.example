// This file is NOT built (its extension is .go.example, not .go). It is the
// pinned shape of the code the generator emits, committed so Phase 8's emitter
// can be diffed against it — field names/order and method signatures, not
// byte-identical output, since real graphs vary. Phase 3's hand-authored test
// stand-ins in rt/lifecycle_test.go match this shape so that generated code of
// the same shape inherits Phase 3's behavioral suite.
//
// The graph modeled here is the ADR-003 diamond:
//
//	DB → {Router, Worker}
//
// DB is the sole base dependency (start level 001); Router and Worker each depend
// on DB and on nothing else, so they share start level 002 and run concurrently.
// Shutdown (quiesce, then teardown) traverses the same levels in reverse: 002
// before 001.

// Code generated by yama from wire_gen.go. DO NOT EDIT.

package app

import (
	"context"

	yama "l7e.io/yama/v2"
	"l7e.io/yama/v2/rt"
)

// NewLifecycle constructs the application through Wire, wraps each lifecycle
// component through the interceptor chains, and returns the application beside
// its Lifecycle. On construction failure it returns nil, nil, err; on success it
// captures and discards Wire's raw cleanup so teardown runs only through
// Lifecycle.Stop.
func NewLifecycle(opts ...yama.Option) (*App, yama.Lifecycle, error) {
	app, cleanup, err := buildApp()
	if err != nil {
		return nil, nil, err
	}
	_ = cleanup

	chains, begin, end := rt.Assemble(opts...)

	l := &yamaLifecycle{begin: begin, end: end}
	l.level001 = &yamaLevel001{
		startDB:   chains.WrapStart(app.DB),
		quiesceDB: chains.WrapQuiesce(app.DB),
		stopDB:    chains.WrapStop(app.DB),
	}
	l.level002 = &yamaLevel002{
		startRouter:   chains.WrapStart(app.Router),
		quiesceRouter: chains.WrapQuiesce(app.Router),
		stopRouter:    chains.WrapStop(app.Router),
		startWorker:   chains.WrapStart(app.Worker),
		quiesceWorker: chains.WrapQuiesce(app.Worker),
		stopWorker:    chains.WrapStop(app.Worker),
	}

	return app, rt.NewLifecycle(l.startPass, l.shutdown), nil
}

// yamaLifecycle holds the graph's lifecycle state: the two boundary sets and the
// generated levels. Its startPass and shutdown methods encode ordering directly —
// there is no runtime level list interpreted by a loop. rt.NewLifecycle wraps
// these two methods with the cross-cutting policy (startup context cancellation,
// startup-failure cleanup, once-only shutdown).
type yamaLifecycle struct {
	begin *rt.Boundary
	end   *rt.Boundary

	level001 *yamaLevel001
	level002 *yamaLevel002
}

// startPass runs the Start pass: begin boundary, then graph levels in dependency
// order, then end boundary. Any failure short-circuits, so no later level starts.
func (l *yamaLifecycle) startPass(ctx context.Context) error {
	if err := l.begin.Start(ctx); err != nil {
		return err
	}
	if err := l.level001.Start(ctx); err != nil {
		return err
	}
	if err := l.level002.Start(ctx); err != nil {
		return err
	}
	if err := l.end.Start(ctx); err != nil {
		return err
	}
	return nil
}

// shutdown runs the quiesce pass to completion, then the teardown pass. Shutdown
// is the exact reverse of startup: the end boundary runs first and the begin
// boundary last, with the graph levels in reverse dependency order between them.
// The begin boundary is a base dependency of the whole graph, so it tears down
// after everything; the end boundary is a top dependent, so it tears down first.
func (l *yamaLifecycle) shutdown(ctx context.Context) {
	l.end.Quiesce(ctx)
	l.level002.Quiesce(ctx)
	l.level001.Quiesce(ctx)
	l.begin.Quiesce(ctx)

	l.end.Stop(ctx)
	l.level002.Stop(ctx)
	l.level001.Stop(ctx)
	l.begin.Stop(ctx)
}

// yamaLevel001 is start level 001: the base dependency DB. One started flag per
// lifecycle component scopes quiesce and stop to what actually started.
type yamaLevel001 struct {
	startDB   yama.Starter
	quiesceDB yama.Quiescer
	stopDB    yama.Stopper
	startedDB rt.Flag
}

func (lvl *yamaLevel001) Start(ctx context.Context) error {
	g := rt.NewGroup(ctx)
	g.Go(lvl.startDB, &lvl.startedDB)
	return g.Wait()
}

func (lvl *yamaLevel001) Quiesce(ctx context.Context) {
	g := rt.NewShutdownGroup(ctx)
	g.Go(lvl.quiesceDB.Quiesce, &lvl.startedDB)
	g.Wait()
}

func (lvl *yamaLevel001) Stop(ctx context.Context) {
	g := rt.NewShutdownGroup(ctx)
	g.Go(lvl.stopDB.Stop, &lvl.startedDB)
	g.Wait()
}

// yamaLevel002 is start level 002: Router and Worker, independent of each other,
// started concurrently and torn down concurrently.
type yamaLevel002 struct {
	startRouter   yama.Starter
	quiesceRouter yama.Quiescer
	stopRouter    yama.Stopper
	startedRouter rt.Flag

	startWorker   yama.Starter
	quiesceWorker yama.Quiescer
	stopWorker    yama.Stopper
	startedWorker rt.Flag
}

func (lvl *yamaLevel002) Start(ctx context.Context) error {
	g := rt.NewGroup(ctx)
	g.Go(lvl.startRouter, &lvl.startedRouter)
	g.Go(lvl.startWorker, &lvl.startedWorker)
	return g.Wait()
}

func (lvl *yamaLevel002) Quiesce(ctx context.Context) {
	g := rt.NewShutdownGroup(ctx)
	g.Go(lvl.quiesceRouter.Quiesce, &lvl.startedRouter)
	g.Go(lvl.quiesceWorker.Quiesce, &lvl.startedWorker)
	g.Wait()
}

func (lvl *yamaLevel002) Stop(ctx context.Context) {
	g := rt.NewShutdownGroup(ctx)
	g.Go(lvl.stopRouter.Stop, &lvl.startedRouter)
	g.Go(lvl.stopWorker.Stop, &lvl.startedWorker)
	g.Wait()
}

// A component that lacks a capability contributes no member to that pass: the
// generator wraps only the capabilities the component implements. Every lifecycle
// component still carries a started flag, so quiesce and teardown gate uniformly
// on it. A component with no Start method is handed the rt.Started sentinel in the
// start step, which marks its flag when the level is reached — its start is
// reaching its level. Its quiesce/teardown then gate on that same flag, so a
// non-Starter in a level the startup never reached is left alone:
